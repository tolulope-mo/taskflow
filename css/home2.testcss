body {
    font-family: "Space Grotesk", sans-serif;
    background-color: #ffffff;
    color: #333;
    margin: 0;
}

/* DARK MODE
body.dark {
    background-color: #121212;
    color: #f1f1f1;
} */

#header {
    margin: 12px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#first-section {
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#first-section h2 {
    font-size: 20px;
    font-weight: bold;
    letter-spacing: -1px;
    margin-bottom: 4px;
}

#first-section p {
    font-size: 16px;
    font-weight: regular;
    letter-spacing: -1px;
    /* margin-bottom: 4px; */
}

#first-section button {
    background-color: #FF9326;
    border: none;
    padding: 8px 16px;
    color: white;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
    font-weight: regular;
}

#search-area {
    display: flex;
    align-items: center;
    border: 1px solid grey;
    border-radius: 10px;
    padding: 4px 8px;
    justify-content: space-between;
    box-sizing: border-box;
}

#search-area input {
    display: flex;
    border:  none;
    width: 100%;
    height: px;
    padding: 10px;
    
}

#search-area input:focus {
    outline: none;
    border: none;
    box-shadow: none;
}


#search-area button {
    display: flex;
    justify-content: center;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    width: 16px;
    height: 16px;
    /* padding: 4px; */

}

#searchIcon {
    width: 16px;
    height: 16px;
    border-color: #FF9326;
}



#filter-buttons {
    display: flex;
    gap: 20px;
    padding: 10px 15px;
}

.filter {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
}

.filter.active {
    border-bottom: 2px solid  #FF9326;
}

/* Task List */
#task-list {
    padding: 15px;
}

.task-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 15px;
}

.yellow {
    background-color: #fffec9;
}

.green {
    background-color: #dfffdc;
}

.red {
    background-color: #ffe9e9;
}

/* POPUP MODAL */

#popupBg {
    display: none; 
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(175, 168, 168, 0.5);
    justify-content: center;
    align-items: center;
    
}

#addTaskPopup {
    background: white;
    width: 90%;
    max-width: 400px;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0px 4px 20px rgba(0,0,0,0.3);
}

#addTaskPopup input,
#addTaskPopup textarea {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
}

#addTaskBtn {
    background: #FF9326;
    border: none;
    width: 100%;
    padding: 12px;
    border-radius: 5px;
    color: white;
    cursor: pointer;
}

/* MEDIA QUERY – center content on larger screens */
@media (min-width: 768px) {
    body {
        display: flex;
        justify-content: center;
    }

    body > * {
        width: 80%;
    }

    #addTaskPopup{
        width: 60%;
    }
}

#overall-div {
    display: flex;
    flex-direction: column;
}
